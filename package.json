{
  "name": "srt",
  "version": "1.8.2",
  "license": "MIT",
  "scripts": {
    "ng": "ng",
    "dev": "ng serve  --disable-host-check --host 0.0.0.0 --watch --configuration=local ",
    "postinstall": "node scripts/postinstall.js",
    "start": "ng serve",
    "build": "ng build --output-hashing=all",
    "build-local": "ng build --output-hashing=all --configuration=local",
    "build-dev": "ng build --output-hashing=all --configuration=dev",
    "build-staging": "ng build --output-hashing=all --configuration=staging",
    "build-prod": "ng build --output-hashing=all --configuration=prod",
    "ngtest": "ng test",
    "testall": "ng run dev &;  && npm run test && sh kill4200.sh  ",
    "test": "./node_modules/.bin/protractor test/protractor/protractor.conf.js",
    "testtest": "./node_modules/.bin/webdriver-manager update && ./node_modules/.bin/webdriver-manager start --detach  && ./node_modules/.bin/protractor test/protractor/protractor.conf.js && ./node_modules/.bin/webdriver-manager shutdown  && ps -eaf | grep webdriver-manager | grep -v grep | cut -d ' ' -f 4 | xargs kill",
    "killwebdriver": "ps -eaf | grep webdriver-manager | grep -v grep | cut -d ' ' -f 4 | xargs kill",
    "lint": "ng lint",
    "e2e": "ng e2e"
  },
  "private": true,
