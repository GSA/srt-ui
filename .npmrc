# @angular/animations@21.2.1 is the final release of that package (Angular 21
# folded animations into core) and pins its @angular/core peer to exactly
# 21.2.1, while core itself has moved on to 21.2.x patches carrying security
# fixes. npm's strict peer resolution refuses that combination; yarn v1 — which
# this project used to build with — ignored peer conflicts entirely.
#
# legacy-peer-deps reproduces that historical behavior, so the dependency tree
# is the same one the app has always shipped, while package-lock.json still
# pins exact versions. Revisit when BrowserAnimationsModule is dropped from
# app.module.ts, at which point @angular/animations can be removed outright.
legacy-peer-deps=true
