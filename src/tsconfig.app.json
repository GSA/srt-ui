{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "outDir": "../out-tsc/app",
    "baseUrl": "",
    "types": [
      "node"
    ],
    "allowSyntheticDefaultImports": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "exclude": [
    "test.ts",
    "**/*.spec.ts",
    "../node_modules/karma/config.tpl.ts"
  ],
  "include": [
    "**/*.ts",
    "*.ts"
  ]
}